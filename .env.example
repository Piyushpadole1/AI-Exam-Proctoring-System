# AI Exam Proctoring System - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_eval8_db
DB_USER=root
DB_PASSWORD=your_database_password_here

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_hex_here
SERVER_PORT=5000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000
