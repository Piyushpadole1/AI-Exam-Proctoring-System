{
  "name": "ai-exam-proctoring-system",
  "version": "1.0.0",
  "description": "AI Exam Proctoring and Evaluation System - Java Spring Boot & React",
  "scripts": {
    "server": "java -jar backend-spring/target/examproctoring-1.0.0.jar",
